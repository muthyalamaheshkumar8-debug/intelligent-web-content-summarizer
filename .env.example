# Copy to server/.env for native development; root .env is used by Docker Compose.
GEMINI_API_KEY=replace_with_real_gemini_key
GEMINI_MODEL=gemini-3.8-flash
MONGODB_URI=mongodb://127.0.0.1:27017/websummarizer
PORT=5000
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000
SCRAPER_URL=http://127.0.0.1:5001
# Generate independent random values of at least 32 characters.
SESSION_SECRET=replace_with_random_session_secret
SCRAPER_TOKEN=replace_with_random_scraper_token
# Set to the exact number of trusted reverse-proxy hops; direct access uses 0.
TRUST_PROXY=0
